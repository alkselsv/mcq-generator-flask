# Flask
APP_SECRET_KEY=your_secret_key
MAX_CONTENT_LENGTH=262144

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT=600
OPENAI_MAX_RETRIES=2

# Text limits
MIN_TEXT_LENGTH=100
MAX_TEXT_LENGTH=16000
MIN_NUM_QUESTIONS=1
MAX_NUM_QUESTIONS=20
DEFAULT_NUM_QUESTIONS=5
TEXT_CHUNK_SIZE=4000
TEXT_MIN_CHUNK_SIZE=200
MAX_TOPUP_ROUNDS=3
MAX_QUESTIONS_PER_CALL=12

# Redis / RQ
REDIS_URL=redis://localhost:6379/0
RQ_JOB_TIMEOUT=1800
JOB_TTL=3600
JOB_STALE_TIMEOUT=1800

# Question storage
# QUESTIONS_STORAGE_DIR=/tmp/mcq_questions
QUESTIONS_MAX_FILE_AGE=86400

# Frontend polling
POLL_INTERVAL_MS=2000
POLL_MAX_MS=1800000

# Logging
LOG_LEVEL=INFO
LOG_LLM_PREVIEW_LENGTH=300
LOG_HTTP_DEBUG=false

# Gunicorn
WEB_CONCURRENCY=1
GUNICORN_THREADS=32
GUNICORN_TIMEOUT=300
GUNICORN_BIND=0.0.0.0:5000
# GUNICORN_GRACEFUL_TIMEOUT=120
# GUNICORN_KEEPALIVE=2
# GUNICORN_BACKLOG=2048
# GUNICORN_MAX_REQUESTS=0
# GUNICORN_MAX_REQUESTS_JITTER=10
